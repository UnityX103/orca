#!/bin/bash
set -euo pipefail

usage() {
  printf 'Usage: %s [--package-only | --queue-package <version> | --install-package <dmg-path>]\n' "$0"
}

case "${1:-}" in
  '') action=orca:dev:install ;;
  --package-only) action=orca:dev:package ;;
  --queue-package|--install-package)
    if [[ $# != 2 || -z $2 ]]; then
      usage >&2
      exit 2
    fi
    action=$1
    package_input=$2
    if [[ $action == --install-package && $package_input != /* ]]; then
      package_input="$PWD/$package_input"
    fi
    ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

if [[ $(uname -s) != Darwin || $(uname -m) != arm64 ]]; then
  printf 'Orca development builds require an Apple Silicon Mac.\n' >&2
  exit 1
fi

repo_root=$(cd -- "$(dirname -- "$0")/.." && pwd -P)
toolchain="$HOME/.orca/sorca-development/toolchain"
(umask 077; mkdir -p "$toolchain/bin")
if ! node -e 'process.exit(process.versions.node.split(".")[0] === "24" ? 0 : 1)' 2>/dev/null; then
  if [[ ! -x "$toolchain/node_modules/node/bin/node" ]]; then
    npm install --prefix "$toolchain" --no-audit --no-fund --no-package-lock --no-save node@24
  fi
  export PATH="$toolchain/node_modules/node/bin:$PATH"
fi

corepack enable --install-directory "$toolchain/bin" pnpm
export PATH="$toolchain/bin:$PATH"
cd "$repo_root"
if [[ ! -x node_modules/.bin/tsx ]]; then
  pnpm install --frozen-lockfile
fi
case "$action" in
  --queue-package|--install-package)
    exec node --import tsx config/scripts/desktop-distribution/macos/build-sorca-development.mjs "$action" "$package_input"
    ;;
esac
if [[ ! -x mobile/node_modules/.bin/expo ]]; then
  pnpm --dir mobile install --frozen-lockfile
fi
exec pnpm "$action"
